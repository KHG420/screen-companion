# Local development: allow phones on the same trusted LAN to reach the host.
LISTEN_ADDR=0.0.0.0:8080
# Optional, configure your own STUN/TURN for cross-network use.
STUN_URLS=
TURN_URLS=
TURN_SECRET=
# Public deployment requires TLS, either here or at an existing reverse proxy.
TLS_CERT_FILE=
TLS_KEY_FILE=
